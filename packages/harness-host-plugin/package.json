{
  "name": "xiaozhushou-harness-host",
  "version": "0.3.7",
  "description": "小助手独立桌面会话，复用已登录 Harness 的模型、Skill 和已授权插件工具",
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./text-policy.mjs": "./text-policy.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "server.mjs",
    "image-input.mjs",
    "contract-image-input.mjs",
    "contract-tool-policy.mjs",
    "text-policy.mjs",
    "owner-access.mjs",
    "product-access.mjs",
    "contract-product-tools.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

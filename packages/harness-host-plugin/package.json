{
  "name": "xiaozhushou-harness-host",
  "version": "1.0.7",
  "description": "小助手独立桌面会话，复用已登录 Harness 的模型、Skill 和已授权插件工具",
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./text-policy.mjs": "./text-policy.mjs",
    "./conversation-compaction.mjs": "./conversation-compaction.mjs",
    "./conversation-compaction-*.mjs": "./conversation-compaction-*.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "entry-*.mjs",
    "*-*.mjs",
    "server.mjs",
    "context-policy.mjs",
    "conversation-compaction.mjs",
    "image-input.mjs",
    "contract-image-input.mjs",
    "contract-tool-policy.mjs",
    "contract-model-failure.mjs",
    "text-policy.mjs",
    "owner-access.mjs",
    "product-access.mjs",
    "contract-product-tools.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
